# ============================================================
# DermaAI backend environment configuration (EXAMPLE)
# ============================================================
#
# Copy this file to `backend/.env` and fill in real values.
# The backend reads these from the environment (or from backend/.env).
# Never commit real secrets.

# ------------------------------------------------------------
# Required (backend refuses to start in production without these)
# ------------------------------------------------------------

# Production only: force deployment-mode checks.
#   development | production
# DERMA_APP_ENV=development

# JWT signing secret. REQUIRED in production and must be at least 32
# characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# DERMA_JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of allowed browser origins (no wildcard "*").
# REQUIRED in production. For local development the defaults
# (http://localhost:5173, http://127.0.0.1:5173) are used when unset.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ------------------------------------------------------------
# Optional tuning
# ------------------------------------------------------------

# JWT lifetime in minutes (default 1440 = 24 hours).
# DERMA_JWT_EXPIRE_MINUTES=1440

# PBKDF2 iterations for password hashing (default 600000).
# DERMA_PBKDF2_ITERATIONS=600000

# Rate limiting (defaults shown). Set DERMA_RATE_LIMIT=0 to disable.
# DERMA_RATE_LIMIT=1
# DERMA_RATE_WINDOW=60
# DERMA_RATE_SIGNUP=10
# DERMA_RATE_LOGIN=10
# DERMA_RATE_PREDICT=15
# DERMA_RATE_STATIC=120

# Set to 1 when running behind a reverse proxy so the first
# X-Forwarded-For value is trusted as the client IP.
# DERMA_TRUST_PROXY=0

# JWT signing algorithm (default HS256). Keep the default unless you
# know what you are doing.
# DERMA_JWT_ALGORITHM=HS256
