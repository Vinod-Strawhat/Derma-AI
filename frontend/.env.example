# ============================================================
# DermaAI frontend environment configuration (EXAMPLE)
# ============================================================
#
# Copy this file to `frontend/.env` and fill in real values.
# Never commit real secrets.
#
# ------------------------------------------------------------
# DermaAI backend API (for real analysis mode)
# ------------------------------------------------------------
#
# Set this to the DermaAI backend URL to enable real AI analysis.
# Leave empty to stay in demo mode (mock results in the browser).
# VITE_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------
# Nearby Dermatologist search provider
# ------------------------------------------------------------
#
# Free and requires no API key or configuration.
#
# Geocoding of a city/area uses OpenStreetMap Nominatim and the nearby
# places search uses the Overpass API. Both run directly from the
# browser, send the user's coordinates only to those providers, and
# comply with their public usage policies at low demo volume.
#
# See https://operations.osmfoundation.org/policies/nominatim/ and
# https://dev.overpass-api.de/overpass-doc/en/preface/commons.html
#
# No VITE_GOOGLE_MAPS_API_KEY (or any other key) is needed anymore.